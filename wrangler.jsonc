{
  "name": "susukino-ssmap",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/data.js", "/api/*", "/images/*", "/staff", "/staff/*", "/admin", "/admin/*"]
  },
  // D1（店舗データ・アップロード写真）は、初回のデプロイ時に自動で作成されます。
  "d1_databases": [{ "binding": "DB", "database_name": "ssmap-db" }],
  "vars": {
    // 承認者（管理者）のメールアドレス。複数ならカンマ区切り
    "ADMIN_EMAILS": "shingu.white@gmail.com",
    "TRANSLATE_MODEL": "claude-sonnet-5-5"
  }
}
